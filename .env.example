# FastAPI
DATABASE_URL=postgresql+psycopg://ai_tutor:local-development-only@localhost:5433/ai_tutor
PDF_STORAGE_DIR=data/books
CORS_ORIGINS=http://localhost:5173

# Add LLM and Embedding API keys only after the providers are selected.
